{
  "name": "cs2-craft",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-viewer.mjs && tsc -b && vite build",
    "test": "vitest run src && node --test scripts/offline-viewer.test.mjs",
    "viewer:prepare": "node scripts/prepare-viewer.mjs",
    "desktop": "tauri dev",
    "package": "node scripts/verify-snapshot.mjs && tauri build --bundles nsis",
    "catalog:prepare": "cargo run --manifest-path tools/catalog-builder/Cargo.toml --target-dir src-tauri/target --release",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --release --lib"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
